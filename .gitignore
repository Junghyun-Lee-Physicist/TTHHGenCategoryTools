# =============================================================================
# TTHHGenCategoryTools — ignore run artefacts, keep provenance
# =============================================================================
# Rule of thumb: anything a command REGENERATES is ignored; anything that is an
# INPUT to a command (e.g. a DAS scan log that a generator parses) is committed.

# --- read-only checker output (submit_ttbarIdExtend.py --preflight, preflight.py)
preflight_*.log

# --- CRAB submit/kill/status transcripts
submit_*_20*.log
status_*_20*.log
crab_projects/

# --- local cmsRun test outputs (see TtbarIdExtender/README.md sec.1)
#     NB: VarParsing appends _numEventN when maxEvents is set.
ttbarIDExtend*.root
sidecar*.root
local_extend_*.log
local_*_check.log

# --- Validation build + run outputs
Validation/bin/
Validation/logs20*/
Validation/sorted20*/
# NOTE: Validation/lookup<era>/ is intentionally NOT ignored -- the per-era
# analyzer patch files are COMMITTED (2017 precedent: Validation/lookup/).
# They are the analyzer's input and are small (~12 MB for 7 samples), and the
# analyzer runs at KNU while they are produced on lxplus, so committing them is
# what actually moves them between environments (2026-07-28 decision).
# Only the regenerable by-products stay ignored:
Validation/lookup20*/_tmp*/
hist_*.root
ttnb_*.root
# ...but the curated per-era lookup directories ARE tracked (see the note above
# and Validation/lookup*/README.txt). The bare rule exists to keep stray
# re-derivations out of the Validation working dir; the committed artifacts live
# only under lookup/ and lookup<era>/.
!Validation/lookup/ttnb_*.root
!Validation/lookup20*/ttnb_*.root
ttbarIdPatch_*.root
!Validation/lookup/ttbarIdPatch_*.root
!Validation/lookup20*/ttbarIdPatch_*.root

# --- era-scoped filelists generated by make_filelists*.py / make_nano_filelists_das.sh
#     (the 2017 campaign lists ARE committed: filelists/nano/, filelists/sidecar/)
Validation/filelists/nano20*/
Validation/filelists/sidecar20*/

# --- python / editor / OS
__pycache__/
*.pyc
*.swp
.DS_Store
._*

# Condor validation campaign (2026-07-28). Work/log/args files are regenerable;
# the real outputs live on EOS (out-base), never here.
Validation/condor_val*/
Validation/valout*/
Validation/scripts/__pycache__/
Validation/match_*.root
Validation/.done_*

# Grid proxy. The submit workflow asks you to create it in the working directory
# (see Validation/README.md 4.0) because /tmp is invisible to the condor schedd.
# It is a CREDENTIAL -- never commit it.
proxy.cert
*.proxy
x509up_u*
